<Project>

  <!-- 全仓库共享的编译设置。所有子项目都继承这里，避免每个 csproj 重复。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

    <!-- 本框架刻意保持零 NuGet 依赖：核心只用 BCL，测试用自带的迷你运行器。 -->
    <RestorePackages>false</RestorePackages>

    <!--
      关掉 NuGet 漏洞审计。这个仓库没有第三方依赖，审计本身没有信息量；
      而它会去 nuget.org 取漏洞数据，在本机的离线环境里取不到 → NU1900。
      NU1900 本身只是警告，但 tools/build.ps1 用 -warnaserror 构建，于是它变成
      构建失败——"离线"是这个仓库的既定前提，不能让它把每次构建都判死。
    -->
    <NuGetAudit>false</NuGetAudit>

    <!-- 公开 API 全部有 XML 注释，但内部成员没有，关掉 CS1591 噪音。 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    版本号（单一事实来源）。
    ============================================================================
    这里定的版本会同时成为程序集版本、文件版本，以及 NekoClicker.Core 对外承诺的
    公开 API 版本（"framework 版本"），三者在 tools/build.ps1 里被一条守卫要求一致。

    为什么必须手写在这个文件里、而不是从 git tag 推导：
    `dnet.ps1` 的存在前提就是"本机可能没有网络、也可能没有 git 元数据"，从 tag 推导
    会让构建在浅克隆 / 导出源码包 / 无 .git 的环境里直接失败或产出 0.0.0。
    版本号是这个框架对使用者的承诺，不该依赖构建环境碰巧具备什么。

    改版本号的规矩（详见 engine/docs/VERSIONING.md）：
      - 公开 API 只增不改（新增类型 / 新增成员）        → minor
      - 公开 API 有任何不兼容改动（删 / 改签名 / 改语义）→ major
      - 纯文案、数值、内容包、注释                      → patch
    改完必须同时更新 engine/core/PublicApi.txt 与 CHANGELOG.md，
    否则 tools/build.ps1 -Strict 会红（PublicApiTests + VersionTests 两条守卫）。
  -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <!--
      程序集版本 = 完整语义版本（而不是只取 major）。
      消费者可能把 NekoClicker.Core.dll 直接拷进宿主目录（Unity / Mono 场景），
      同目录覆盖升级时，只取 major 会让 1.1.0 和 1.0.0 的文件版本号无法区分。
    -->
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>NekoClicker</Product>
  </PropertyGroup>

</Project>
