<Project>

  <!-- 全仓库共享的编译设置。所有子项目都继承这里，避免每个 csproj 重复。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

    <!-- 本框架刻意保持零 NuGet 依赖：核心只用 BCL，测试用自带的迷你运行器。 -->
    <RestorePackages>false</RestorePackages>

    <!--
      关掉 NuGet 漏洞审计。这个仓库没有第三方依赖，审计本身没有信息量；
      而它会去 nuget.org 取漏洞数据，在本机的离线环境里取不到 → NU1900。
      NU1900 本身只是警告，但 tools/build.ps1 用 -warnaserror 构建，于是它变成
      构建失败——"离线"是这个仓库的既定前提，不能让它把每次构建都判死。
    -->
    <NuGetAudit>false</NuGetAudit>

    <!-- 公开 API 全部有 XML 注释，但内部成员没有，关掉 CS1591 噪音。 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    版本号（单一事实来源）。
    ============================================================================
    这里定的版本会同时成为程序集版本、文件版本，以及 NekoClicker.Core 对外承诺的
    公开 API 版本（"framework 版本"），三者在 tools/build.ps1 里被一条守卫要求一致。

    为什么必须手写在这个文件里、而不是从 git tag 推导：
    `dnet.ps1` 的存在前提就是"本机可能没有网络、也可能没有 git 元数据"，从 tag 推导
    会让构建在浅克隆 / 导出源码包 / 无 .git 的环境里直接失败或产出 0.0.0。
    版本号是这个框架对使用者的承诺，不该依赖构建环境碰巧具备什么。

    改版本号的规矩（详见 engine/docs/VERSIONING.md）：
      - 公开 API 只增不改（新增类型 / 新增成员）        → minor
      - 公开 API 有任何不兼容改动（删 / 改签名 / 改语义）→ major
      - 纯文案、数值、内容包、注释                      → patch

    **已知例外**：1.1.0、1.5.0、1.6.0 都是"改了已有成员的效果、却按 minor 发布"，
    而且都是**同一处**——结局的落定时机：1.1.0 引入 30 模拟秒的作答宽限；
    1.5.0 把它换成"玩家被展示过待答表态"这个条件；1.6.0 又收紧成"玩家把它们答完"。
    **1.12.0 是第四处、也是换了一处的第一处**：`NumFormat.FormatShort` 在
    1000 ~ 999999 上的输出从 `1,234` 变成 `1.234K`（短刻度表补上千位档，
    索引 0 从 1e6 挪到 1e3）。按本表"改语义 = major"的字面该升 major，
    这次按先例走 minor——理由与影响面写在 CHANGELOG 的 1.12.0 与 VERSIONING §2.1。
    四次都写明了理由，**不是**给这条规矩开先例。
    改完必须同时更新 engine/core/PublicApi.txt 与 CHANGELOG.md，
    否则 tools/build.ps1 -Strict 会红（PublicApiTests + VersionTests 两条守卫）。

    **1.12.1 是标准的一格 patch**：公开 API 一行没动（`PublicApi.txt` 重生成之后
    只差首行 `version=`），改的全是**工具链与文档**——新增 `tools/play-web.ps1`
    （把这一局在缺 ASP.NET 8 运行时的机器上正确起起来），外加一轮真人游玩
    带来的文档与登记（4 条真人延迟样本、H2 的半侧结论、新登记的 F 组）。
    它在语义上本该并进 1.12.0 那条，但 1.12.0 已经落地在树上，按仓库口径
    "攒够一条就结一次桶"另起一个 patch 号，见 CHANGELOG 的 1.12.1。

    **1.13.0 是一格 minor（2026-10-20 拍板）**：公开 API 仍然一行没动
    （`PublicApi.txt` 重生成之后只差首行 `version=`），桶里 13 节全是
    宿主 / 前端 / 工具链 / 测试工程 / 文档的改动。按 §2 那张表它本该是
    patch，升 minor 的理由：D18 那个"1.12.0 该 minor 还是 major"的疑问
    在结桶时被人拍成"往上调不往下调"——K/M/B/T 那一轮的影响面
    （`ShortScaleNames` 起点 1e6→1e3）仍在消化期内，本桶把它记成
    minor 是给下游一个"这批变更比 patch 重"的信号，不是给规矩开先例。
  -->
  <PropertyGroup>
    <Version>1.13.0</Version>
    <!--
      程序集版本 = 完整语义版本（而不是只取 major）。
      消费者可能把 NekoClicker.Core.dll 直接拷进宿主目录（Unity / Mono 场景），
      同目录覆盖升级时，只取 major 会让 1.1.0 和 1.0.0 的文件版本号无法区分。
    -->
    <AssemblyVersion>1.13.0.0</AssemblyVersion>
    <FileVersion>1.13.0.0</FileVersion>
    <Product>NekoClicker</Product>
  </PropertyGroup>

  <!--
    剧情文本随包发布。
    ============================================================================
    内容包目录下若有 text.json，就把它复制到输出目录的 content/<包目录名>/text.json
    —— ContentText.Load("<包目录名>") 正是从那里读（与 dll 同目录，于是 dotnet run、
    测试、publish 三种情形走同一条路）。

    规则写在共享 props 里、而不是十个 csproj 各写一份：它是一条**通用能力**，
    新增内容包只要放一个 text.json 就自动生效；引用该包的项目（Demo / Web / 测试）
    会传递地拿到它，publish 也会带上。路径里的包名从项目所在目录名推出，
    与内容包"一个目录一个 csproj"的约定一致。
  -->
  <PropertyGroup>
    <ContentPackDir>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</ContentPackDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\text.json')">
    <None Include="text.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>content/$(ContentPackDir)/text.json</Link>
    </None>
  </ItemGroup>

</Project>
