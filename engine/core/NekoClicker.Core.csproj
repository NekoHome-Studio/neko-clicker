<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NekoClicker.Core</RootNamespace>
    <AssemblyName>NekoClicker.Core</AssemblyName>
    <!-- 框架核心：无 UI、无 IO 硬编码、无第三方依赖，可在控制台/Web/Unity 中复用。 -->
    <Description>增量（放置/点击）游戏框架核心引擎。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      NuGet 分发形态（登记册 W5）。
      ============================================================================
      `IsPackable` 对类库本来就是 true，写出来是为了把它**变成一条承诺**：
      这个项目可以被 `dotnet pack`，而不是"碰巧默认能打"。将来若有人在共享 props
      里关掉可打包性，这里会把它钉住。
      `PackageId` 默认取自 AssemblyName（同样是 NekoClicker.Core），显式写出来是为了
      让"包名"这件事不再依赖"程序集名恰好没被改"这个巧合。
      版本号**只有一处事实来源**（仓库根 Directory.Build.props 的 <Version>），
      这里刻意不写 <Version> —— 打包会自动跟上它。
    -->
    <PackageId>NekoClicker.Core</PackageId>
    <IsPackable>true</IsPackable>

    <!-- 包作者：不写的话 NuGet 会拿程序集名（NekoClicker.Core）当作者，那是个默认值、不是个署名。 -->
    <Authors>NekoHome Studio</Authors>
  </PropertyGroup>

  <!--
    公开 API 快照（见 engine/docs/VERSIONING.md）。
    它被<b>嵌进程序集</b>而不是留在测试项目里，理由是这份快照属于 Core 自己的契约：
    任何拿到 NekoClicker.Core.dll 的宿主都能断言"这个 dll 的公开 API 与我预期的一致"，
    而不需要拿到本仓库的测试代码。测试项目通过 EmbeddedResource 清单把它读出来做比较。
    内容由 tools\public-api.ps1 生成，不要手改。
  -->
  <ItemGroup>
    <EmbeddedResource Include="PublicApi.txt" LogicalName="NekoClicker.Core.PublicApi.txt" />
  </ItemGroup>

  <!--
    这里没有 InternalsVisibleTo：核心对测试也只暴露公开 API。
    （ContentText 试点期间曾给测试开过一个，1.2.0 它转公开之后就撤掉了——
    测试能用公开 API 说清楚的事，不该靠开放内部来换。）
  -->
</Project>
