<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NekoClicker.Content.Lab</RootNamespace>
    <AssemblyName>NekoClicker.Content.Lab</AssemblyName>
    <!--
      内容包 #3：猫娘实验室（道德黑残深）。
      第一个同时用到 Era + Lore + Choice 三项引擎能力的包——
      它存在的意义之一就是证明这三项能力能共用一个核心，而核心不需要为它加任何分支。
    -->
    <Description>内容包 #3：猫娘实验室的全部数值与文案（伦理值模块 + 批次纪元 + 道德轴）。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\NekoClicker.Core.csproj" />
  </ItemGroup>

  <!--
    剧情散文（text.json）随包发布这件事不在这里写：它已经上收到仓库根的
    Directory.Build.props，成了一条通用规则（内容包目录里有 text.json 就自动复制到
    content/<目录名>/text.json）。试点期间这条规则只写在 Lab 一个 csproj 里，
    迁移到全部内容包时才发现它该是共享的——十个包各写一份既啰嗦、又会让
    "新增一个包"多一个容易忘的步骤。
  -->

</Project>
