<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NekoClicker.Content.Lab</RootNamespace>
    <AssemblyName>NekoClicker.Content.Lab</AssemblyName>
    <!--
      内容包 #3：猫娘实验室（道德黑残深）。
      第一个同时用到 Era + Lore + Choice 三项引擎能力的包——
      它存在的意义之一就是证明这三项能力能共用一个核心，而核心不需要为它加任何分支。
    -->
    <Description>内容包 #3：猫娘实验室的全部数值与文案（伦理值模块 + 批次纪元 + 道德轴）。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\NekoClicker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      剧情散文随包发布。这个文件必须和 dll 一起走到输出目录，否则
      ContentText.Load("Lab") 会在第一次读文案时抛「文件不存在」——
      也就是说"丢文件"会当场炸，而不是悄悄变成一本空白图鉴。

      Link 决定复制过去之后的相对路径：content/Lab/text.json。
      引用本包的项目（Demo / Web / 测试）会**传递地**拿到这个文件，
      与 wwwroot 走的是同一条机制；publish 也会带上。
    -->
    <None Include="text.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>content/Lab/text.json</Link>
    </None>
  </ItemGroup>

</Project>
