<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NekoClicker.Demo.Cli</RootNamespace>
    <AssemblyName>neko-clicker</AssemblyName>
    <!-- 终端 UI 适配层：只读 GameSnapshot + 发命令，不碰任何游戏规则。 -->
    <Description>终端可玩 Demo：ANSI 全屏界面 + 键盘交互。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 帧渲染的尺寸不变量由测试项目直接盯着（FrameRenderTests）：
         Render 返回的每一行必须恰好等于终端宽/高，这类错误在真实终端上表现为滚屏与错位，
         在无头环境里却完全看不出来——必须用测试钉住。 -->
    <InternalsVisibleTo Include="NekoClicker.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 全部内容包都引用：用命令行 package 参数选择要玩的游戏。 -->
    <ProjectReference Include="..\NekoClicker.Core\NekoClicker.Core.csproj" />
    <ProjectReference Include="..\NekoClicker.Content.Neko\NekoClicker.Content.Neko.csproj" />
    <ProjectReference Include="..\NekoClicker.Content.Cafe\NekoClicker.Content.Cafe.csproj" />
    <ProjectReference Include="..\NekoClicker.Content.NineLives\NekoClicker.Content.NineLives.csproj" />
    <ProjectReference Include="..\NekoClicker.Content.Lab\NekoClicker.Content.Lab.csproj" />
    <ProjectReference Include="..\NekoClicker.Content.Company\NekoClicker.Content.Company.csproj" />
    <ProjectReference Include="..\NekoClicker.Content.Apocalypse\NekoClicker.Content.Apocalypse.csproj" />
    <ProjectReference Include="..\NekoClicker.Content.Library\NekoClicker.Content.Library.csproj" />
    <ProjectReference Include="..\NekoClicker.Content.God\NekoClicker.Content.God.csproj" />
  </ItemGroup>

</Project>
