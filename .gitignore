# 构建产物
bin/
obj/
*.user

# tools/pack.ps1 打出来的分发包
artifacts/

# tools/dnet.ps1 重定向出来的 dotnet CLI home 与 NuGet 包缓存
.dotnet/
.packages/

# 运行时存档 / 日志
*.save
saves/
.probe/

# 临时文件
*.tmp
.tmp/

# crash log (CrashLog.cs)
neko-clicker-crash.log

# Web 前端（分支 feature/web-frontend-ui）
# 注意：pnpm 的 store 会建在仓库根（实测 `pnpm store path` 返回 <repo>\.pnpm-store\v11），
# 体积很大且与本仓库无关，必须忽略。而 wwwroot / web\dist 是签进仓库的构建产物，不忽略。
.pnpm-store/
web/node_modules/
web/.vite/
node_modules/

# AI 助手的技能包（`npx skills add` 装进来的，2026-11-06）
# 它们是**工具产物**，不是这个游戏的一部分：三个目录（.agents / .claude / agent）里是
# 同一份 skill 的复制与软链，内容来自上游仓库（这里装的是 LottieFiles/motion-design-skill，MIT）。
# 谁本地装谁用；签进版本库只会让仓库多出几百 KB 与一条与游戏无关的依赖。
.agents/
.claude/
agent/
skills-lock.json