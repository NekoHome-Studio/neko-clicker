<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>NekoClicker.Web</RootNamespace>
    <AssemblyName>neko-clicker-web</AssemblyName>
    <!-- Web 宿主：只读 GameSnapshot + 发命令，不碰任何游戏规则。 -->
    <Description>Web 前端宿主：把游戏引擎暴露给浏览器（本地 HTTP + 静态 wwwroot）。</Description>

    <!--
      与整个仓库同一个目标框架（Directory.Build.props 的 net8.0），不再单独覆盖。

      **这里原本是 net10.0**，理由写的是"本机只有 Microsoft.AspNetCore.App 10.x、
      没有 8.0.x，所以 net8 编得过但 dotnet run 起不来"。合并时实测发现这条与事实不符：
        · 本机 SDK 列表里只有 8.0.303（dotnet 的 list-sdks 子命令）—— 连 **编译** net10.0
          都做不到（NETSDK1045: The current .NET SDK does not support targeting .NET 10.0）；
        · 运行时 `Microsoft.AspNetCore.App 8.0.7` **是装了的**，net8 起得来。
      所以 net10.0 在这台机器上是"既编不过、又没必要"。

      改成 net8.0 的代价只有一处：`System.Threading.Lock`（.NET 9 起才有）换回 `object`
      —— 它本来就只出现在 `lock (...)` 里，是等价替换。收益是**一个 SDK 编全部**，
      以及 Web 宿主不再是一个只在别人机器上成立的例外。
    -->
    <TargetFramework>net8.0</TargetFramework>

    <!--
      语言版本跟随 Directory.Build.props 的 12.0。原先为了配合 net10.0 单独放成 latest，
      而那只是因为 `System.Threading.Lock` 在 C# 12 下报 CS9202——改用 object 之后
      这个理由也一并消失，于是回归与引擎同级。
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      与 Demo.Cli 同样的接线方式：引用 Core + 全部内容包，用命令行/URL 参数选择要玩的游戏。
      只有一个包能"选择"时，前端才不会被焊死在某一个作品上。

      注意这里的引用是**枚举的**（每个包一行），但宿主代码里没有任何包名是硬编码的：
      /api/packs 是扫描输出目录里的 NekoClicker.Content.*.dll 发现的（见 Program.cs）。
      所以新增一个包要在这个列表补一行，但不需要改宿主逻辑。
    -->
    <ProjectReference Include="..\..\..\engine\core\NekoClicker.Core.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Neko\NekoClicker.Content.Neko.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Cafe\NekoClicker.Content.Cafe.csproj" />
    <ProjectReference Include="..\..\..\engine\content\NineLives\NekoClicker.Content.NineLives.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Lab\NekoClicker.Content.Lab.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Company\NekoClicker.Content.Company.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Apocalypse\NekoClicker.Content.Apocalypse.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Library\NekoClicker.Content.Library.csproj" />
    <ProjectReference Include="..\..\..\engine\content\God\NekoClicker.Content.God.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Civ\NekoClicker.Content.Civ.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Cyber\NekoClicker.Content.Cyber.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Dream\NekoClicker.Content.Dream.csproj" />
  </ItemGroup>

</Project>
