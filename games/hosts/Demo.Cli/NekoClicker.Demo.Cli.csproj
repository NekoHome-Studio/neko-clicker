<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NekoClicker.Demo.Cli</RootNamespace>
    <AssemblyName>neko-clicker</AssemblyName>
    <!-- 终端 UI 适配层：只读 GameSnapshot + 发命令，不碰任何游戏规则。 -->
    <Description>终端可玩 Demo：ANSI 全屏界面 + 键盘交互。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 帧渲染的尺寸不变量由测试项目直接盯着（FrameRenderTests）：
         Render 返回的每一行必须恰好等于终端宽/高，这类错误在真实终端上表现为滚屏与错位，
         在无头环境里却完全看不出来——必须用测试钉住。 -->
    <InternalsVisibleTo Include="NekoClicker.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      宿主侧共用的两份源码以**共享源码**的形式编进来（与测试项目编 Web 的 SnapshotProtocol 同一个机制）：
      仓库根定位（RepositoryPaths）与作答延迟埋点（ChoiceLatencyLog）。

      为什么必须共享而不是各写一份：埋点有两份实现时，**默认启动器跑的那一份**（终端）
      只把样本攒在内存里，而 Web 那一份才写文件——于是"照默认方式玩一局"一个样本都不会留下
      （artifacts/latency.txt：21 条 session start、0 条 S 行）。两份实现之间不存在任何东西
      会去发现"它们的行为已经分叉"；共享一份源码是唯一能保证这一点的形状。
      见 engine/docs/STRUCTURE_OPTIMIZATION.md §S13。
    -->
    <Compile Include="..\Shared\ChoiceLatencyLog.cs" Link="Shared\ChoiceLatencyLog.cs" />
    <Compile Include="..\Shared\RepositoryPaths.cs" Link="Shared\RepositoryPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 全部内容包都引用：用命令行 package 参数选择要玩的游戏。 -->
    <ProjectReference Include="..\..\..\engine\core\NekoClicker.Core.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Neko\NekoClicker.Content.Neko.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Cafe\NekoClicker.Content.Cafe.csproj" />
    <ProjectReference Include="..\..\..\engine\content\NineLives\NekoClicker.Content.NineLives.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Lab\NekoClicker.Content.Lab.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Company\NekoClicker.Content.Company.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Apocalypse\NekoClicker.Content.Apocalypse.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Library\NekoClicker.Content.Library.csproj" />
    <ProjectReference Include="..\..\..\engine\content\God\NekoClicker.Content.God.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Civ\NekoClicker.Content.Civ.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Cyber\NekoClicker.Content.Cyber.csproj" />
    <ProjectReference Include="..\..\..\engine\content\Dream\NekoClicker.Content.Dream.csproj" />
  </ItemGroup>

</Project>
